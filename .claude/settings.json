{
  "respectGitignore": true,
  "includeGitInstructions": true,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(C:/Users/atayl/VoxCore/**)",
      "Edit(C:/Users/atayl/Desktop/**)",
      "Write(C:/Users/atayl/VoxCore/**)",
      "Write(C:/Users/atayl/Desktop/**)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "LSP",
      "NotebookEdit(*)",
      "TaskCreate(*)",
      "TaskGet(*)",
      "TaskList(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "TaskUpdate(*)",
      "TeamCreate(*)",
      "TeamDelete(*)",
      "mcp__arcanum__*",
      "mcp__docs-rag__*",
      "mcp__voxcore-db__*",
      "mcp__voxcore-server__*",
      "mcp__local-llm__*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*recovery-codes*)",
      "Read(**/*backup-codes*)",
      "Read(**/credentials.json)",
      "Read(**/Pword.txt)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook_daemon.py\" --ensure",
            "timeout": 3,
            "statusMessage": "Ensuring hook daemon..."
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/timestamp-injector",
            "timeout": 2
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/prompt-context-injector",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/block-recurring-cron",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/sql-safety",
            "timeout": 2
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/release-gate-enforce",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/sensitive-file-guard",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/large-file-guard",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_write_size.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/tab-ownership-check",
            "timeout": 2,
            "statusMessage": "Checking tab ownership..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "prompt",
            "if": "Write(*publishable*)|Edit(*publishable*)",
            "model": "haiku",
            "timeout": 15,
            "prompt": "You are a pre-publish quality gate for a WoW addon/tool. Check if this code contains any of: (1) debug print/console.log/print() statements, (2) hardcoded test values or localhost URLs, (3) TODO/FIXME/HACK comments, (4) commented-out code blocks >3 lines, (5) API keys or credentials. Content being written: $ARGUMENTS. Respond ONLY with JSON: {\"decision\": \"allow\"} if clean, or {\"decision\": \"block\", \"reason\": \"[specific issue found]\"} if problems detected. Be strict — this is shipping to users.",
            "statusMessage": "Publish quality gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/edit-verifier",
            "timeout": 5
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/cpp-build-reminder",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/release-gate-revalidate",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/session-stats",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/sync-on-git",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/grep-case-enricher",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__voxcore-server__restart|mcp__voxcore-server__start",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "voxcore-server",
            "tool": "tail_log",
            "input": { "log": "server", "lines": 30, "pattern": "ERROR|FATAL|WARNING|World initialized" },
            "timeout": 10,
            "statusMessage": "Auto-checking server log..."
          }
        ]
      },
      {
        "matcher": "mcp__voxcore-db__safe_apply",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "voxcore-server",
            "tool": "tail_log",
            "input": { "log": "dberrors", "lines": 20 },
            "timeout": 10,
            "statusMessage": "Auto-checking DB error log..."
          }
        ]
      },
      {
        "matcher": "mcp__voxcore-server__build",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "voxcore-server",
            "tool": "tail_log",
            "input": { "log": "dberrors", "lines": 15 },
            "timeout": 10,
            "statusMessage": "Checking for DB errors post-build..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/session-stats",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/docx-auto-extract",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__voxcore-db__query|mcp__voxcore-db__safe_apply",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "voxcore-db",
            "tool": "tribal_knowledge",
            "input": { "keyword": "${tool_input.database}" },
            "timeout": 5,
            "statusMessage": "Fetching DB tribal knowledge..."
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/db-failure-chain",
            "timeout": 3,
            "statusMessage": "Analyzing DB failure..."
          }
        ]
      },
      {
        "matcher": "mcp__voxcore-server__start|mcp__voxcore-server__restart",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "voxcore-server",
            "tool": "tail_log",
            "input": { "log": "server", "lines": 50, "pattern": "ERROR|FATAL|ABORT|Cannot bind" },
            "timeout": 10,
            "statusMessage": "Diagnosing server startup failure..."
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/server-failure-chain",
            "timeout": 5,
            "statusMessage": "Analyzing startup failure..."
          }
        ]
      },
      {
        "matcher": "mcp__voxcore-server__build",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/build-failure-chain",
            "timeout": 5,
            "statusMessage": "Analyzing build failure..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.claude/hooks/daemon_shim.py\"",
            "timeout": 5,
            "statusMessage": "Starting hook daemon..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-reinject.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/cowork-sync",
            "timeout": 60,
            "statusMessage": "Full bridge sync..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/stop-verify",
            "timeout": 5
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/cowork-sync",
            "timeout": 2
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/session-stats",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/session-stats",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/subagent-complete",
            "timeout": 3
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/session-stats",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/precompact-snapshot",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/notification-toast",
            "timeout": 3
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "session_state.md|Central_Brain.md|todo.md",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:19484/hook/file-changed-monitor",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
